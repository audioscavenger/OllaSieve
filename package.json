{
  "name": "ollasieve",
  "version": "0.1.0",
  "description": "Agent proxy with optional provider dashboard and classifier proxy",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "debug": "node index.js --debug",
    "help": "node index.js --help",
    "test": "node --test \"tests/*.test.js\"",
    "test:unit": "node --test \"tests/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "lint": "eslint src/**/*.js tests/**/*.js"
  },
  "keywords": [
    "agent",
    "proxy",
    "dashboard",
    "classifier",
    "openchamber",
    "opencode"
  ],
  "author": "Eric Derewonko",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
