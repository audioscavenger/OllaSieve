{
    "extends": ["eslint:recommended"],
    "parserOptions": {
        "ecmaVersion": 2020,
        "sourceType": "module"
    },
    "rules": {
        "no-use-before-define": "error",
        "prefer-const": "warn",
        "max-lines-per-function": ["warn", {"max": 100}],
        "max-lines": ["warn", {"max": 500}],
        "semi": ["error", "always"],
        "quotes": ["error", "single"]
    },
    "env": {
        "node": true,
        "es2020": true
    }
}